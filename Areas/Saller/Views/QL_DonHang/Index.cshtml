@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
}

<div class="content mb-4">
    <h2 class="text-center">QUẢN LÝ ĐƠN HÀNG</h2>
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4>Danh sách cần làm</h4>
                <h2>@ViewBag.PendingOrders</h2>
                <p>Chờ Lấy Hàng</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4>Đã Xử Lý</h4>
                <h2>@ViewBag.ProcessedOrders</h2>
                <p>Đã Xử Lý</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4>Đơn Trả hàng/Hoàn tiền/Hủy</h4>
                <h2>@ViewBag.CanceledOrders</h2>
                <p>Đơn Trả Hàng</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h4>Sản Phẩm Bị Tạm Khóa</h4>
                <h2>0</h2>
                <p>Sản Phẩm Bị Tạm Khóa</p>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h3>Phân Tích Bán Hàng</h3>
        <p>Doanh số: <strong>@ViewBag.Revenue</strong></p>
        <p>Lượt truy cập: <strong>@ViewBag.TotalVisits</strong></p>
        <p>Đơn hàng: <strong>@ViewBag.TotalOrders</strong></p>
    </div>

    <div class="mt-4">
        <h4>Tối đa hóa doanh số bán hàng với Quảng cáo Go!</h4>
        <button class="btn btn-primary">Tìm hiểu thêm</button>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Quảng cáo đang chạy</h4>
            <p>Chưa có</p>
            <button class="btn btn-primary">Go</button>
        </div>
        <div class="col-md-6">
            <h4>Live stream</h4>
            <p>Chưa có</p>
            <button class="btn btn-primary">Bắt đầu ngay</button>
        </div>
    </div>
</div>
