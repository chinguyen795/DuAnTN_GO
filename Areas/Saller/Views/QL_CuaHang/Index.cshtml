@model List<Diner>

<div class="content mb-4">

<h2>Danh sách cửa hàng của bạn</h2>

@if (Model.Count == 0)
{
    <p>❌ Bạn chưa có cửa hàng nào.</p>
}
else
{
        <table class="table">
            <thead>
                <tr>
                    <th>Tên quán</th>
                    <th>Địa chỉ</th>
                    <th>Điện thoại</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var diner in Model)
                {
                    <tr>
                        <td>@diner.DinerName</td>
                        <td>@diner.DinerAddress</td>
                        <td>@diner.PhoneNumber</td>
                        <td>
                            <a href="@Url.Action("Edit", "QL_CuaHang", new { id = diner.Id })" class="btn btn-warning">Sửa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
}
</div>
