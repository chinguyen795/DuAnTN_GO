<!doctype html>
<html lang="en">
<head>
    <title>Title</title>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Seller_style.css">

</head>

<body>
    <!-- Header -->
    <header class="container-fluid header d-flex justify-content-between align-items-center px-3 py-2">
        <!-- Logo -->
        <div class="logo">
            <img src="./IMG-GO.png" alt="Logo" height="90">
        </div>

        <!-- Admin Info -->
        <div class="admin-info d-flex align-items-center">
            <i class="bi bi-person-circle text-white fs-5 me-2"></i>
            <span class="text-white">Admin</span>
        </div>
    </header>

    <!-- Sidebar -->
    <div class="sidebar">
        <div>
            <h5 class="text-center">Quản lý</h5>
            <a asp-area="Saller" asp-controller="QL_CuaHang" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Quảng lý của hàng</a>
            <a asp-area="Saller" asp-controller="QL_DonHang" asp-action="Index"><i class="bi bi-basket"></i> Quản lý đơn hàng</a>
            <a asp-area="Saller" asp-controller="QL_Products" asp-action="Index"><i class="bi bi-box"></i> Quản lý sản phẩm</a>
            <a ><i class="bi bi-gift"></i> Ưu đãi</a>
            <a ><i class="bi bi-wallet"></i> Tài chính</a>
            <a ><i class="bi bi-bell"></i> Thông báo từ GO</a>
        </div>
    </div>
    @RenderBody();
</body>
</html>
