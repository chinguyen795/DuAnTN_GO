   <!-- Content -->
<div class="content mb-4" style="margin-left: 250px; padding: 20px;">
    <h3 class="text-center text-primary">Thêm món ăn</h3>

    <form id="foodForm" action="" method="POST">
        <div class="row">
            <!-- Main Image -->
            <!-- Main Image -->
            <div class="col-md-4">
                <img src="./IMG-GO.png" alt="Ảnh chính" height="100" class="img-fluid mb-3 border rounded p-1"
                     id="mainImage">
                <div class="row">
                    <!-- Secondary Images -->
                    <div class="col-6">
                        <img src="./IMG-GO.png" alt="Ảnh phụ 1" height="60"
                             class="img-fluid mb-3 border rounded p-1" id="image1">
                        <input type="file" class="form-control" id="image1Input" name="image1">
                    </div>
                    <div class="col-6">
                        <img src="./IMG-GO.png" alt="Ảnh phụ 2" height="60"
                             class="img-fluid mb-3 border rounded p-1" id="image2">
                        <input type="file" class="form-control" id="image2Input" name="image2">
                    </div>
                </div>
                <input type="file" class="form-control mt-2" id="mainImageInput" name="mainImage">
            </div>


            <!-- Info Section -->
            <div class="col-md-8">
                <h4>Thông tin món ăn</h4>

                <div class="mb-3">
                    <label for="foodName" class="form-label">Tên món ăn:</label>
                    <input type="text" class="form-control" id="foodName" name="foodName"
                           placeholder="Nhập tên món ăn">
                </div>

                <div class="mb-3">
                    <label for="quantity" class="form-label">Số lượng:</label>
                    <input type="number" class="form-control" id="quantity" name="quantity"
                           placeholder="Nhập số lượng">
                </div>

                <div class="mb-3">
                    <label for="price" class="form-label">Giá (VNĐ):</label>
                    <input type="number" class="form-control" id="price" name="price" placeholder="Nhập giá tiền">
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Danh mục:</label>
                    <select class="form-select" id="category" name="category">
                        <option value="com">Cơm</option>
                        <option value="bun">Bún</option>
                        <option value="pho">Phở</option>
                        <option value="nuoc">Đồ uống</option>
                        <option value="trangmieng">Tráng miệng</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Mô tả:</label>
                    <textarea class="form-control" id="description" name="description" rows="3"
                              placeholder="Nhập mô tả chi tiết về món ăn"></textarea>
                </div>

                <!-- Save Button -->
                <button type="submit" class="btn btn-success mt-3"><i class="bi bi-save"></i> Lưu món ăn</button>
            </div>
        </div>
    </form>
</div>