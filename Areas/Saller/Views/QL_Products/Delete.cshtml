@model DuAnTN.Models.Food

@{
    ViewData["Title"] = "Xóa Món Ăn";
}

<div class="content mb-4">
    <h3 class="text-center text-danger fw-bold">XÓA MÓN ĂN</h3>

    <div class="card shadow-sm p-4 text-center">
        <h5 class="text-dark fw-bold">Bạn có chắc chắn muốn xóa món ăn này?</h5>
        <p class="text-muted">Hành động này <strong>không thể hoàn tác</strong>.</p>

        <div class="mb-3">
            <img src="@Model.MainImage" class="img-thumbnail shadow-sm" width="150">
        </div>

        <h4 class="fw-bold text-dark">@Model.FoodName</h4>
        <p class="text-muted">@Model.Price.ToString("N0") VNĐ</p>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-center mt-3">
                <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash"></i> Xóa</button>
                <a asp-action="Index" class="btn btn-secondary ms-3 px-4"><i class="bi bi-x-lg"></i> Hủy</a>
            </div>
        </form>
    </div>
</div>
