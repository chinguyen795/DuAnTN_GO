@model DuAnTN.Models.Food

@{
    ViewData["Title"] = "Chỉnh Sửa Món Ăn";
}

<div class="content mb-4">
    <h3 class="text-center text-dark fw-bold">CHỈNH SỬA MÓN ĂN</h3>

    <div class="card shadow-sm p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <!-- Phần thông tin món ăn -->
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="FoodName" class="form-label fw-bold">Tên món ăn</label>
                        <input asp-for="FoodName" class="form-control" required maxlength="150">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá (VNĐ)</label>
                        <input asp-for="Price" type="number" class="form-control" required min="0">
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Danh mục</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Hoạt động</option>
                            <option value="Inactive">Không hoạt động</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <!-- Phần upload ảnh -->
                <div class="col-md-4 d-flex flex-column align-items-center">
                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold">Ảnh Chính</label>
                        <input type="file" name="MainImage" class="form-control" onchange="previewImage(event, 'mainImagePreview')">
                        <img id="mainImagePreview" src="@Model.MainImage" class="img-thumbnail mt-2 shadow-sm img-preview">
                    </div>

                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold">Ảnh Phụ 1</label>
                        <input type="file" name="Image1" class="form-control" onchange="previewImage(event, 'image1Preview')">
                        <img id="image1Preview" src="@Model.Image1" class="img-thumbnail mt-2 shadow-sm img-preview">
                    </div>

                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold">Ảnh Phụ 2</label>
                        <input type="file" name="Image2" class="form-control" onchange="previewImage(event, 'image2Preview')">
                        <img id="image2Preview" src="@Model.Image2" class="img-thumbnail mt-2 shadow-sm img-preview">
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center mt-3">
                <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-lg"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-secondary ms-3 px-4"><i class="bi bi-x-lg"></i> Hủy</a>
            </div>
        </form>
    </div>
</div>

<!-- CSS kiểm soát ảnh -->
<style>
    .img-preview {
        max-width: 60px;
        max-height: 60px;
        object-fit: cover;
    }
</style>
