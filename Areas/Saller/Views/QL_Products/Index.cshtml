@model List<DuAnTN.Models.Food>

<div class="content mb-4">
    <h3 class="text-center text-dark">QUẢN LÝ MÓN ĂN</h3>

    <!-- Thanh tìm kiếm và nút thêm món ăn -->
    <div class="d-flex justify-content-between mb-3">
        <!-- Nút Thêm món ăn -->
        <a asp-controller="QL_Products" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm món ăn
        </a>

        <!-- Ô tìm kiếm -->
        <form method="get" class="d-flex">
            <input type="text" name="search" class="form-control w-25" placeholder="Tìm kiếm món ăn..." value="@ViewBag.Search">
            <button type="submit" class="btn btn-secondary ms-2">Tìm</button>
        </form>
    </div>

    <!-- Kiểm tra nếu có dữ liệu -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tên món ăn <i class="bi bi-arrow-down-up px-1"></i></th>
                        <th>Giá <i class="bi bi-arrow-down-up px-1"></i></th>
                        <th>Mô tả</th>
                        <th>Ảnh chính</th>
                        <th>Ảnh phụ 1</th>
                        <th>Ảnh phụ 2</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var food = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@food.FoodName</td>
                            <td>@food.Price.ToString("N0")đ</td>
                            <td>@food.Description</td>
                            <td><img src="@food.MainImage" alt="Ảnh chính" height="60"></td>
                            <td><img src="@food.Image1" alt="Ảnh phụ 1" height="60"></td>
                            <td><img src="@food.Image2" alt="Ảnh phụ 2" height="60"></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        &#8942;
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item text-warning" asp-action="Edit" asp-route-id="@food.Id">Chỉnh sửa</a></li>
                                        <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@food.Id">Xóa</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-center text-muted">Không có món ăn nào.</p>
    }
</div>