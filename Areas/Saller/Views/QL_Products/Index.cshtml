<div class="content mb-4" style="margin-left: 250px; padding: 20px;">
    <h3 class="text-center text-dark">QUẢN LÝ SẢN PHẨM</h3>

    <!-- Thanh tìm kiếm và nút thêm sản phẩm -->
    <div class="d-flex justify-content-between mb-3">
        <!-- Nút Thêm sản phẩm -->
        <a asp-area="Saller" asp-controller="QL_Products" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm
        </a>

        <!-- Ô tìm kiếm -->
        <input type="text" class="form-control w-25" placeholder="Tìm kiếm sản phẩm...">
    </div>


    <!-- Bảng sản phẩm -->
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tên sản phẩm<i class="bi bi-arrow-down-up px-1"></i></th>
                    <th>Giá<i class="bi bi-arrow-down-up px-1"></i></th>
                    <th>Số lượng</th>
                    <th>Ảnh chính</th>
                    <th>Ảnh phụ 1</th>
                    <th>Ảnh phụ 2</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Bánh xèo</td>
                    <td>25.000đ</td>
                    <td>50</td>
                    <td><img src="./IMG-GO.png" alt="Ảnh chính" height="60"></td>
                    <td><img src="./IMG-GO.png" alt="Ảnh phụ 1" height="60"></td>
                    <td><img src="./IMG-GO.png" alt="Ảnh phụ 2" height="60"></td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-warning" href="#">Chỉnh sửa</a></li>
                                <li><a class="dropdown-item text-danger" href="#">Xóa</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Cơm gà</td>
                    <td>28.000đ</td>
                    <td>30</td>
                    <td><img src="./IMG-GO.png" alt="Ảnh chính" height="60"></td>
                    <td><img src="./IMG-GO.png" alt="Ảnh phụ 1" height="60"></td>
                    <td><img src="./IMG-GO.png" alt="Ảnh phụ 2" height="60"></td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-warning" href="#">Chỉnh sửa</a></li>
                                <li><a class="dropdown-item text-danger" href="#">Xóa</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>