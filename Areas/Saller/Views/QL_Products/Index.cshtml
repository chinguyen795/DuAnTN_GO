@model List<DuAnTN.Models.Food>

<div class="content mb-4">
    <h3 class="text-center text-dark fw-bold">QUẢN LÝ MÓN ĂN</h3>

    <!-- Thanh công cụ -->
    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Thêm món ăn
        </a>

        <!-- Ô tìm kiếm -->
        <form method="get" class="d-flex">
            <input type="text" name="search" class="form-control me-2" placeholder="Tìm món ăn..." value="@ViewBag.Search">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <!-- Bảng danh sách món ăn -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 25%;">Tên món</th>
                    <th style="width: 10%;">Giá</th>
                    <th style="width: 15%;">Ảnh</th>
                    <th style="width: 15%;">Trạng thái</th>
                    <th style="width: 15%;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var food = Model[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <!-- Giới hạn tên món ăn để không tràn -->
                            <td class="fw-semibold text-truncate" style="max-width: 180px;" title="@food.FoodName">
                                @food.FoodName
                            </td>
                            <td class="text-primary fw-bold">@food.Price.ToString("N0") đ</td>
                            <td>
                                <img src="@food.MainImage" class="rounded border shadow-sm" height="50" alt="Ảnh món ăn">
                            </td>
                            <td>
                                <span class="badge bg-@(food.Status == "Hoạt động" ? "Không hoạt động" : "danger")">
                                    @food.Status
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item text-warning" asp-action="Edit" asp-route-id="@food.Id">
                                                <i class="bi bi-pencil-square"></i> Chỉnh sửa
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@food.Id">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center py-3">Không có món ăn nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
