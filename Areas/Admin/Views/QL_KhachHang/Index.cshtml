@model List<DuAnTN.Models.UserInfo>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng";
}
@{
    var searchTerm = ViewBag.SearchTerm as string;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
}

<h3 class="text-center text-dark">QUẢN LÝ KHÁCH HÀNG</h3>

<!-- Thanh tìm kiếm -->
<div class="d-flex justify-content-end mb-3">
    <form method="get">
        <input type="text" class="form-control w-200" name="search" value="@searchTerm" placeholder="Tìm kiếm khách hàng...">
    </form>
</div>

<!-- Bảng khách hàng -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Sinh nhật</th>
                <th>Giới tính</th>
                <th>CCCD</th>
                <th>Ngày tạo</th>
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody id="customerList">
            @foreach (var userInfo in Model)
            {
                <tr>
                    <td>@userInfo.Id</td>
                   @*  <td>@userInfo.FullName</td>
                    <td>@userInfo.Phone</td> *@
                    <td>@userInfo.User?.FullName</td>
                    <td>@userInfo.User?.Email</td>
                    <td>@userInfo.BirthDay</td>
                    <td>@userInfo.Gender</td>
                    <td>@userInfo.IdentityCard</td>
                    <td>@userInfo.CreateAt</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a asp-action="Delete" asp-route-id="@userInfo.Id" class="dropdown-item text-danger fw-bold"
                                       onclick="return confirm('Bạn có chắc muốn xóa?')">
                                        <i class="bi bi-trash3-fill me-2"></i> Xóa
                                    </a>
                                </li>
                                <li>
                                    <form method="post" asp-action="Hide" asp-route-id="@userInfo.Id">
                                        <button type="submit" class="dropdown-item text-warning fw-bold">
                                            <i class="bi @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(userInfo.Id) ? "bi-eye-fill" : "bi-eye-slash-fill") me-2"></i>
                                            @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(userInfo.Id) ? "Hiện" : "Ẩn")
                                        </button>
                                    </form>
                                </li>
                            </ul>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Hiển thị Phân Trang -->
<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = ViewBag.Page - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = ViewBag.Page + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>


