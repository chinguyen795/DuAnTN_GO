@model List<DuAnTN.Models.UserInfo>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng";
}


<h3 class="text-center text-dark">QUẢN LÝ KHÁCH HÀNG</h3>

<!-- Thanh tìm kiếm -->
<form method="get" class="d-flex align-items-center justify-content-between mb-3">
    

    <input type="text" class="form-control w-25" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm danh mục...">
</form>

<!-- Bảng khách hàng -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Tên</th>
                <th>Điện thoại</th>
                <th>Sinh nhật</th>
                <th>Địa chỉ</th>
                <th>CCCD</th>
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody id="customerList">
            @foreach (var userInfo in Model)
            {
                <tr>
                    <td>@userInfo.Id</td>
                    <td>@userInfo.FullName</td>
                    <td>@userInfo.Phone</td>
                    <td>@userInfo.User?.Email</td>
                    <td>@userInfo.User?.Addresses</td>
                    <td>@userInfo.IdentityCard</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("Delete", "QL_KhachHang", new { area = "Admin", deleteId = userInfo.Id })">
                                        Xóa
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="#">Ẩn</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Hiển thị Phân Trang -->
<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = ViewBag.Page - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_KhachHang", new { search = ViewBag.Search, page = ViewBag.Page + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

