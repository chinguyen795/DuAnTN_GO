@model List<DuAnTN.Models.Diner>

@{
    var searchTerm = ViewBag.SearchTerm as string;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
}

<h3 class="text-center text-dark">CỬA HÀNG</h3>

<!-- Thanh tìm kiếm -->
<div class="d-flex justify-content-end mb-3">
    <form method="get">
        <input type="text" class="form-control w-200" name="search" value="@searchTerm" placeholder="Tìm kiếm cửa hàng...">
    </form>
</div>

<!-- Bảng cửa hàng -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Tên cửa hàng</th>
                <th>Ảnh</th>
                <th>Địa chỉ</th>
                <th>Mã số thuế</th>
                <th>Chủ cửa hàng</th>
                <th>Ngày đăng kí</th>
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var diner in Model)
            {
                <tr>
                    <td>@diner.Id</td>
                    <td>@diner.DinerName</td>
                    <td><img src="@diner.MainImage" alt="" height="60"></td>
                    <td>@diner.DinerAddress</td>
                    <td>@diner.TaxCode</td>
                    <td>@diner.User?.Email</td>
                    <td>@diner.CreateAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-danger" href="#">Ngừng kinh doanh</a></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("Index", "QL_CuaHang", new { area = "Admin", deleteId = diner.Id })">
                                        Xóa
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_CuaHang", new { search = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "QL_CuaHang", new { search = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QL_CuaHang", new { search = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

@if (Context.Request.Query["deleteId"].Count > 0)
{
    int deleteId = int.Parse(Context.Request.Query["deleteId"]);
    var dinerToDelete = Model.FirstOrDefault(c => c.Id == deleteId);

    if (dinerToDelete != null)
    {
        <div class="modal fade show" style="display:block;" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 id="deleteModalLabel" class="modal-title text-danger">Xác nhận xóa</h5>
                        <a href="@Url.Action("Index", "QL_CuaHang", new { area = "Admin" })" class="btn-close"></a>
                    </div>
                    <div class="modal-body">
                        <p>Bạn có chắc chắn muốn xóa danh mục "<strong>@dinerToDelete.DinerName</strong>" không?</p>
                    </div>
                    <div class="modal-footer">
                        <a href="@Url.Action("Index", "QL_CuaHang", new { area = "Admin" })" class="btn btn-secondary">Hủy</a>
                        <form method="post" action="@Url.Action("Delete", "QL_CuaHang", new { area = "Admin" })">
                            <input type="hidden" name="id" value="@deleteId" />
                            <button type="submit" class="btn btn-danger">Xóa</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}