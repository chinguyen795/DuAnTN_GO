   <!-- Nội dung chính -->
<h3 class="text-center text-dark">QUẢN LÝ DANH MỤC</h3>

<!-- Nút Thêm (mở modal #addModal) -->
<form method="get" class="d-flex align-items-center justify-content-between mb-3">
    <button type="button" class="btn btn-success px-4 py-2" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-square"></i> Thêm
    </button>

    <input type="text" class="form-control w-25" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm danh mục...">
</form>



<!-- Bảng Danh mục -->
    @model List<Category>

<div class="container">
    <!-- Các ô danh mục (5 cột, khoảng cách g-2) -->
    <div class="row row-cols-1 row-cols-md-5 g-2">
        @foreach (var category in Model)
        {
            <div class="col">
                <div class="category-box d-flex align-items-center justify-content-between p-2 border rounded">
                    <span>@category.CategoryName</span>

                    <div class="dropdown">
                        <button class="btn btn-light border-0 dropdown-toggle" type="button" data-bs-toggle="dropdown"></button>
                        <ul class="dropdown-menu">
                            
                            <!-- Nút xóa -->
                            <a class="dropdown-item text-warning" href="@Url.Action("Index", "Catelogy", new { area = "Admin", id = category.Id })">
                                Sửa
                            </a>
                            <a class="dropdown-item text-danger" href="@Url.Action("Index", "Catelogy", new { area = "Admin", deleteId = category.Id })">
                                Xóa
                            </a>

                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "Catelogy", new { area = "Admin", search = ViewBag.Search, page = ViewBag.Page - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "Catelogy", new { area = "Admin", search = ViewBag.Search, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "Catelogy", new { area = "Admin", search = ViewBag.Search, page = ViewBag.Page + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>



<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="addModalLabel" class="modal-title">Thêm Danh Mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Form Thêm Danh Mục -->
                <form method="post" action="@Url.Action("Create", "Catelogy", new { area = "Admin" })">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Tên danh mục</label>
                        <input type="text" class="form-control" id="categoryName" name="CategoryName" placeholder="Nhập tên danh mục" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </form>
            </div>
        </div>
    </div>
</div>



@if (ViewBag.CategoryToEdit != null)
{
    var categoryToEdit = (Category)ViewBag.CategoryToEdit;

    <div class="modal fade show" style="display:block;" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="editModalLabel" class="modal-title">Sửa Danh Mục</h5>
                    <a href="@Url.Action("Index", "Catelogy", new { area = "Admin" })" class="btn-close"></a>
                </div>
                <div class="modal-body">
                    <!-- Form Sửa Danh Mục -->
                    <form method="post" action="@Url.Action("Edit", "Catelogy", new { area = "Admin" })">
                        <input type="hidden" name="Id" value="@categoryToEdit.Id" />
                        <div class="mb-3">
                            <label for="editCategoryName" class="form-label">Tên danh mục</label>
                            <input type="text" class="form-control" name="CategoryName" value="@categoryToEdit.CategoryName" required />
                        </div>
                        <div class="modal-footer">
                            <a href="@Url.Action("Index", "Catelogy", new { area = "Admin" })" class="btn btn-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
@if (Context.Request.Query["deleteId"].Count > 0)
{
    int deleteId = int.Parse(Context.Request.Query["deleteId"]);
    var categoryToDelete = Model.FirstOrDefault(c => c.Id == deleteId);

    if (categoryToDelete != null)
    {
        <div class="modal fade show" style="display:block;" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="false">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 id="deleteModalLabel" class="modal-title text-danger">Xác nhận xóa</h5>
                        <a href="@Url.Action("Index", "Catelogy", new { area = "Admin" })" class="btn-close"></a>
                    </div>
                    <div class="modal-body">
                        <p>Bạn có chắc chắn muốn xóa danh mục "<strong>@categoryToDelete.CategoryName</strong>" không?</p>
                    </div>
                    <div class="modal-footer">
                        <a href="@Url.Action("Index", "Catelogy", new { area = "Admin" })" class="btn btn-secondary">Hủy</a>
                        <form method="post" action="@Url.Action("DeleteConfirmed", "Catelogy", new { area = "Admin" })">
                            <input type="hidden" name="id" value="@deleteId" />
                            <button type="submit" class="btn btn-danger">Xóa</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
