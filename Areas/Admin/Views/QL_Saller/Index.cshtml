@model List<DuAnTN.Models.Diner>

@{
    ViewData["Title"] = "Quản Lý Saller";
}

<h3 class="text-center text-dark">QUẢN LÝ SALLER</h3>

<!-- Thanh tìm kiếm -->
<div class="d-flex justify-content-end mb-3">
    <form asp-action="Index" method="get" class="d-flex w-25">
        <input type="text" name="searchQuery" class="form-control"
               placeholder="Tìm kiếm khách hàng..."
               value="@ViewBag.SearchQuery"
               onkeyup="submitOnEnter(event)">
    </form>
</div>
<!-- Bảng Seller -->
<div class="table-container mt-3">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Người quản lí</th>
                <th>Điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Cửa hàng</th>
                <th>Sản phẩm</th> 
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var diner in Model)
            {
                <tr>
                    <td>@diner.Id</td>
                    <td>@diner.PhoneNumber</td>
                    <td>@diner.User?.Email</td>
                    <td>@diner.DinerAddress</td>
@*                     <td>@user.Diners?.</td>
                    <td>@user.Role</td>
                   <td>
                        @(diner.Foods?.Count() ?? 0) <!-- Kiểm tra nếu Foods có tồn tại -->
                        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal"
                                data-bs-target="#exampleModal">
                            <i class="bi bi-border-style"></i>
                        </button>
                    </td> *@
                    <td>
                        <div class="dropend">
                            <button class="btn btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-success" href="#">Xem tất cả</a></li>
                                <li><a class="dropdown-item text-warning" href="#">Tạm ngừng</a></li>
                                <li><a class="dropdown-item text-danger" href="#">Xóa</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>






<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Chi tiết số lượng sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-success table-striped">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Tên sản phẩm</th>
                            <th scope="col">Giá</th>
                            <th scope="col">Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">1</th>
                            <td>Bún bò</td>
                            <td>100.000đ</td>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>