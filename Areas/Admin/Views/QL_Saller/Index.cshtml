@model List<DuAnTN.Models.Diner>

@{
    ViewData["Title"] = "Quản Lý Saler";
}

@{
    var searchTerm = ViewBag.SearchTerm as string;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
}

<h3 class="text-center text-dark">QUẢN LÝ SALER</h3>

<!-- Thanh tìm kiếm -->
<div class="d-flex justify-content-end mb-3">
    <form method="get">
        <input type="text" class="form-control w-200" name="search" value="@searchTerm" placeholder="Tìm kiếm saler...">
    </form>
</div>
<!-- Bảng Seller -->
<div class="table-container mt-3">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Người quản lí</th>
                <th>Điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Cửa hàng</th>
                <th>Sản phẩm</th> 
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var diner in Model)
            {
                <tr>
                    <td>@diner.Id</td>
                    <td>@diner.User?.FullName</td>
                    <td>@diner.PhoneNumber</td>
                    <td>@diner.User?.Email</td>
                    <td>@diner.DinerAddress</td>
                    <td>@diner.DinerName</td>
                   <td>
                        @(diner.Foods?.Count() ?? 0) <!-- Kiểm tra nếu Foods có tồn tại -->
                        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal"
                                data-bs-target="#exampleModal">
                            <i class="bi bi-border-style"></i>
                        </button>
                    </td> 
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                         @*        <li>
                                    <a class="dropdown-item text-primary fw-bold" href="#">
                                        <i class="bi bi-eye me-2"></i> Xem tất cả
                                    </a>
                                </li> *@
                                <li>
                                    <a asp-action="Delete" asp-route-id="@diner.Id" class="dropdown-item text-danger fw-bold"
                                       onclick="return confirm('Bạn có chắc muốn xóa?')">
                                        <i class="bi bi-trash3-fill me-2"></i> Xóa
                                    </a>
                                </li>
                                <li>
                                    <form method="post" asp-action="Hide" asp-route-id="@diner.Id">
                                        <button type="submit" class="dropdown-item text-warning fw-bold">
                                            <i class="bi @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(diner.Id) ? "bi-eye-fill" : "bi-eye-slash-fill") me-2"></i>
                                            @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(diner.Id) ? "Hiện" : "Ẩn")
                                        </button>
                                    </form>
                                </li>
                            </ul>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Chi tiết số lượng sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-success table-striped">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Tên sản phẩm</th>
                            <th scope="col">Giá</th>
                            <th scope="col">Số lượng</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">1</th>
                            <td>Bún bò</td>
                            <td>100.000đ</td>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>