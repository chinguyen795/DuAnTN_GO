@model List<DuAnTN.Models.User>

@{
    ViewData["Title"] = "Quản Lý";
}

@{
    var searchTerm = ViewBag.SearchTerm as string;
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
}

<h3 class="text-center text-dark">QUẢN LÝ</h3>

<!-- Nút Thêm (mở modal #addModal) -->
<form method="get" class="d-flex align-items-center justify-content-between mb-3">
    <button type="button" class="btn btn-success px-4 py-2" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-square"></i> Thêm
    </button>
    <input type="text" class="form-control w-25" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm người dùng...">
</form>

<!-- Bảng khách hàng -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Email</th>
                <th>Password</th>
                <th>RePassWord</th>
                <th>Dinner Id</th>
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    @* <td>@userInfo.User?.Addresses?</td> *@ 
                    @* <td>@userInfo.User?.Role?</td> *@ 
                    <td>@user.Id</td>
                    <td>@user.Email</td>
                    <td>@user.Password</td>
                    <td>@user.RePassword</td>
                    <td>@user.RoleId</td>                
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-warning fw-bold" href="@Url.Action("Index", "QuanLy", new { area = "Admin", id = user.Id })">
                                        <i class="bi bi-pencil-square me-2"></i> Sửa
                                    </a>
                                    <form method="post" asp-action="Hide" asp-route-id="@user.Id">
                                        <button type="submit" class="dropdown-item text-warning fw-bold">
                                            <i class="bi @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(user.Id) ? "bi-eye-fill" : "bi-eye-slash-fill") me-2"></i>
                                            @(ViewBag.HiddenCustomers != null && ((List<int>)ViewBag.HiddenCustomers).Contains(user.Id) ? "Hiện" : "Ẩn")
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="dropdown-item text-danger fw-bold"
                                       onclick="return confirm('Bạn có chắc muốn xóa?')">
                                        <i class="bi bi-trash3-fill me-2"></i> Xóa
                                    </a>
                                </li>
                            </ul>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Hiển thị Phân Trang -->
<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = ViewBag.Page - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = ViewBag.Page + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

<!-- =============== MODALS =============== -->
<!-- Modal Thêm -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="addModalLabel" class="modal-title">Thêm Người Dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Form Thêm Danh Mục -->
                <form method="post" action="@Url.Action("Create", "QuanLy", new { area = "Admin" })">
                     <div class="mb-3">
                        <label for="categoryName" class="form-label">Email</label>
                        <input type="text" class="form-control" id="categoryName" name="Email" placeholder="Nhập email" required>
                    </div>
                     <div class="mb-3">
                        <label for="categoryName" class="form-label">Password</label>
                        <input type="text" class="form-control" id="categoryName" name="Password" placeholder="Nhập mật khẩu" required>
                    </div>
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">RePassword</label>
                        <input type="text" class="form-control" id="categoryName" name="RePassword" placeholder="Nhập lại mật khẩu" required>
                    </div>
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">RoleId</label>
                        <input type="text" class="form-control" id="categoryName" name="RoleId" placeholder="Nhập vai trò" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </form>
            </div>
        </div>
    </div>
</div>




<!-- Modal Sửa -->
@if (ViewBag.CategoryToEdit != null)
{
    var categoryToEdit = (User)ViewBag.CategoryToEdit;

    <div class="modal fade show" style="display:block;" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="editModalLabel" class="modal-title">Sửa Người Dùng</h5>
                    <a href="@Url.Action("Index", "QuanLy", new { area = "Admin" })" class="btn-close"></a>
                </div>
                <div class="modal-body">
                    <!-- Form Sửa Danh Mục -->
                    <form method="post" action="@Url.Action("Edit", "QuanLy", new { area = "Admin" })">
                        <input type="hidden" name="Id" value="@categoryToEdit.Id" />
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Email</label>
                            <input type="text" class="form-control" id="categoryName" name="Email" value="@categoryToEdit.Email" required>
                        </div>
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Password</label>
                            <input type="text" class="form-control" id="categoryName" name="Password" value="@categoryToEdit.Password" required>
                        </div>
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">RePassWord</label>
                            <input type="text" class="form-control" id="categoryName" name="RePassWord" value="@categoryToEdit.RePassword" required>
                        </div>
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">RoleId</label>
                            <input type="text" class="form-control" id="categoryName" name="RoleId" value="@categoryToEdit.RoleId" required>
                        </div>
                        <div class="modal-footer">
                            <a href="@Url.Action("Index", "QuanLy", new { area = "Admin" })" class="btn btn-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}


<!-- Modal Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="deleteModalLabel" class="modal-title text-danger">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc muốn xóa người dùng <strong id="deleteUserName"></strong> không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form asp-action="Delete" method="post">
                    <input type="hidden" id="deleteUserId" name="id">
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>


