@* @model List<DuAnTN.Models.UserInfo>

@{
    ViewData["Title"] = "Quản Lý Vai Trò";
}

<h3 class="text-center text-dark">QUẢN LÝ VAI TRÒ</h3>

<!-- Thanh tìm kiếm -->
<form method="get" class="d-flex align-items-center justify-content-between mb-3">
    <input type="text" class="form-control w-25" name="search" value="@ViewBag.Search" placeholder="Tìm kiếm danh mục...">
</form>
    <!-- Bảng khách hàng -->
<div class="table-container">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Tên <i class="bi bi-arrow-down-up px-1"></i></th>
                <th>Điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>CCCD</th>
                <th>Vai trò</th>
                <th>Công cụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var userInfo in Model)
            {
                <tr>
                    <td>@userInfo.User?.Id</td>
                    <td>@userInfo.FullName</td>
                    <td>@userInfo.Phone</td>
                    <td>@userInfo.User?.Email</td>
                    <td>@userInfo.Address</td>
                    <td>@userInfo.IdentityCard</td>
                    <td>@userInfo.User?.role</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                &#8942;
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-warning" href="#" data-bs-toggle="modal"
                                       data-bs-target="#editModal">
                                        Sửa
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger" href="@Url.Action("Delete", "QuanLy", new { area = "Admin", deleteId = userInfo.Id })">
                                        Xóa
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination-container">
    <nav>
        <ul class="pagination">
            @if (ViewBag.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = ViewBag.Page - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = i })">@i</a>
                </li>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link bg-danger text-white border-danger" href="@Url.Action("Index", "QuanLy", new { search = ViewBag.Search, page = ViewBag.Page + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>

<!-- =============== MODALS =============== -->
<!-- Modal Thêm -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="addModalLabel" class="modal-title">Thêm Khách Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Form Thêm (chỉ UI) -->
                <form>
                    <div class="mb-3">
                        <label for="addName" class="form-label">Tên</label>
                        <input type="text" class="form-control" id="addName" placeholder="Nhập tên...">
                    </div>
                    <div class="mb-3">
                        <label for="addPhone" class="form-label">Điện thoại</label>
                        <input type="text" class="form-control" id="addPhone" placeholder="Nhập số điện thoại...">
                    </div>
                    <div class="mb-3">
                        <label for="addEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="addEmail" placeholder="Nhập email...">
                    </div>
                    <div class="mb-3">
                        <label for="addAddress" class="form-label">Địa chỉ</label>
                        <input type="text" class="form-control" id="addAddress" placeholder="Nhập địa chỉ...">
                    </div>
                    <div class="mb-3">
                        <label for="addCCCD" class="form-label">CCCD</label>
                        <input type="text" class="form-control" id="addCCCD" placeholder="Nhập số CCCD...">
                    </div>
                    <div class="mb-3">
                        <label for="addRole" class="form-label">Vai trò</label>
                        <select id="addRole" class="form-select">
                            <option value="Khách">Khách</option>
                            <option value="Admin">Admin</option>
                            <option value="Người Bán">Người Bán</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="editModalLabel" class="modal-title">Sửa Thông Tin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <!-- Form Sửa (chỉ UI) -->
                <form>
                    <div class="mb-3">
                        <label for="editName" class="form-label">Tên</label>
                        <input type="text" class="form-control" id="editName" value="Nguyễn Văn VVVV">
                    </div>
                    <div class="mb-3">
                        <label for="editPhone" class="form-label">Điện thoại</label>
                        <input type="text" class="form-control" id="editPhone" value="0123456789">
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail" value="a@gmail.com">
                    </div>
                    <div class="mb-3">
                        <label for="editAddress" class="form-label">Địa chỉ</label>
                        <input type="text" class="form-control" id="editAddress" value="Hà Nội">
                    </div>
                    <div class="mb-3">
                        <label for="editCCCD" class="form-label">CCCD</label>
                        <input type="text" class="form-control" id="editCCCD" value="092500209227">
                    </div>
                    <div class="mb-3">
                        <label for="editRole" class="form-label">Vai trò</label>
                        <select id="editRole" class="form-select">
                            <option value="Khách">Khách</option>
                            <option value="Admin" selected>Admin</option>
                            <option value="Người Bán">Người Bán</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="deleteModalLabel" class="modal-title text-danger">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc muốn xóa người dùng <strong id="deleteUserName"></strong> không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form asp-action="Delete" method="post">
                    <input type="hidden" id="deleteUserId" name="id">
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>


 *@