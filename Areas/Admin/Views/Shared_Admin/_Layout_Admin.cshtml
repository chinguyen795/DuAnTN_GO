<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cửa Hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Admin_style.css">
</head>

<body>
    <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i id="sidebar-icon" class="bi bi-chevron-left"></i>
    </button>
    <header class="container-fluid header d-flex justify-content-between align-items-center px-3 py-2">
        <!-- Logo -->
        <div class="logo">
            <img src="~/image/IMG-GO.png" alt="Logo" height="90">
        </div>
        <div class="actions-account d-flex align-items-center text-center">
            @if (Context.Session.GetString("Id") != null)
            {
                <div class="dropdown">
                    <button class="btn dropdown-toggle account-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @Context.Session.GetString("FullName")
                    </button>
                    <ul class="dropdown-menu account-menu">
                        <li class="dropdown-header">@Context.Session.GetString("FullName")</li>
                        <li>
                            <a class="dropdown-item" href="/profile">
                                🔹 Hồ Sơ Cá Nhân
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item logout" href="/logout">
                                🚪 Đăng Xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <div class="actions-account-login" data-bs-toggle="modal" data-bs-target="#login">
                    <a href="#">Log In</a>
                </div>
            }
        </div>

    </header>

    <!-- Sidebar -->
    <div class="sidebar">
        <div>
            <h5 class="text-center">Quản lý</h5>
            <a href="#" onclick="toggleSubMenu()">
                <i class="bi bi-person"></i> Người dùng <i class="bi bi-chevron-down float-end"></i>
            </a>
            <div class="submenu">
                <a asp-area="Admin" asp-controller="QL_KhachHang" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a>
                <a asp-area="Admin" asp-controller="QL_Saller" asp-action="Index"><i class="bi bi-shop"></i> Người bán</a>
                <a asp-area="Admin" asp-controller="QuanLy" asp-action="Index"><i class="bi bi-gear"></i> Quản lý</a>
            </div>
            <a asp-area="Admin" asp-controller="QL_CuaHang" asp-action="Index"><i class="bi bi-shop-window"></i> Cửa hàng</a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box"></i> Sản phẩm</a>
            <a asp-area="Admin" asp-controller="Catelogy" asp-action="Index"><i class="bi bi-boxes"></i> Danh mục</a>
        </div>
        <!-- Thay đoạn này -->
        <div class="account-section">
            <hr class="border-light">
            <a href="Admin_Profile.html"><i class="bi bi-person-circle"></i> Tài khoản</a>
        </div>


    </div>
    <!-- Nội dung chính -->
    <div class="content">
        @RenderBody()        
    </div>
    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
            <div id="liveToast" class="toast show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
                <div class="toast-header">
                    <strong class="me-auto @(TempData["ToastType"]?.ToString() == "success" ? "text-success" : "text-danger")">
                        @((TempData["ToastType"]?.ToString() == "success") ? "✅ Thành công" : "❌ Lỗi")
                    </strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body">
                    @TempData["ToastMessage"]
                </div>
            </div>
        </div>
    }

    <script>
        function toggleSubMenu() {
            var submenu = document.querySelector('.submenu');
            submenu.style.display = submenu.style.display === "block" ? "none" : "block";
        }
        function toggleSidebar() {
            var sidebar = document.querySelector('.sidebar');
            var icon = document.getElementById("sidebar-icon");

            sidebar.classList.toggle('collapsed');

            // Đổi icon khi sidebar đóng hoặc mở
            if (sidebar.classList.contains('collapsed')) {
                icon.classList.remove('bi-chevron-left');
                icon.classList.add('bi-chevron-right'); // Hiện mũi tên >
            } else {
                icon.classList.remove('bi-chevron-right');
                icon.classList.add('bi-chevron-left'); // Hiện mũi tên <
            }
        }
    </script>
</body>



</html>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastEl = document.getElementById("liveToast");
        if (toastEl) {
            var toast = new bootstrap.Toast(toastEl);
            toast.show(); // Hiển thị Toast ngay khi trang load
        }
    });
</script>