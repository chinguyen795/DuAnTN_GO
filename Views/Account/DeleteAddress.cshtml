@model List<DuAnTN.Models.Address>

@{
    ViewData["Title"] = "Danh Sách Địa Chỉ Giao Hàng";
}

<div class="container mt-4">
    <h2>📍 Danh Sách Địa Chỉ Giao Hàng</h2>

    <a asp-controller="Account" asp-action="AddAddress" class="btn btn-primary mb-3">Thêm Địa Chỉ Giao Hàng Mới</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Địa Chỉ</th>
                <th>Chi Tiết</th>
                <th>Chức Năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var address in Model)
            {
                <tr>
                    <td>@address.NameAddress</td>
                    <td>@address.Description</td>
                    <td>
                        <a asp-controller="Account" asp-action="EditAddress" asp-route-id="@address.Id" class="btn btn-warning btn-sm">Sửa</a>

                        <!-- Form xóa địa chỉ -->
                        <form method="post" asp-controller="Account" asp-action="DeleteAddress" asp-route-id="@address.Id" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
