@model DuAnTN.Models.Address

@{
    ViewData["Title"] = "Chỉnh sửa địa chỉ";
}

@if (TempData["ToastMessage"] != null)
{
    <div class="alert alert-@TempData["ToastType"]" role="alert">
        @TempData["ToastMessage"]
    </div>
}

<div class="container mt-4">
    <h2>Chỉnh sửa địa chỉ giao hàng</h2>

    <form method="post">
        <div class="form-group">
            <label for="NameAddress">Số nhà/Tên Đường</label>
            <input type="text" class="form-control" id="NameAddress" name="NameAddress" value="@Model.NameAddress" required />
        </div>

        <div class="form-group">
            <label for="Description">Địa Chỉ</label>
            <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" required />
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật địa chỉ</button>
    </form>
</div>