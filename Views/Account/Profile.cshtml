@model DuAnTN.Models.UserInfo

<div class="container">
    <h3 class="text-center">Thông Tin Cá Nhân</h3>
    <div class="row">
        <div class="col-md-4">
            <img src="@Model.Avatar" alt="Avatar" class="img-fluid">
        </div>
        <div class="col-md-8">
            <h4>@Model.FullName</h4>
            <p><strong>Giới tính:</strong> @Model.Gender</p>
            <p><strong>Địa chỉ:</strong> @Model.Address</p>
            <p><strong>Số điện thoại:</strong> @Model.Phone</p>
            <p><strong>Ngày sinh:</strong> @Model.BirthDay.ToString("dd/MM/yyyy")</p>
            <p><strong>Số CCCD:</strong> @Model.IdentityCard</p>
            <form method="post" action="@Url.Action("EditProfile", "Account")">
                <button type="submit" class="btn btn-primary">Chỉnh sửa thông tin</button>
            </form>
        </div>
    </div>
</div>
