@{
    ViewData["Title"] = "Đăng ký người bán";
}

<div class="container mt-4">
    <div class="container-box">
        <h2>Đăng ký trở thành người bán</h2>
        <hr>

        <!-- Toast thông báo -->
        @if (TempData["ToastMessage"] != null)
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
                <div id="liveToast" class="toast align-items-center text-bg-@TempData["ToastType"] border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
                    <div class="toast-header">
                        <strong class="me-auto">
                            @((TempData["ToastType"]?.ToString() == "success") ? "✅ Thành công" : "❌ Lỗi")
                        </strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">
                        @TempData["ToastMessage"]
                    </div>
                </div>
            </div>
        }

        <div class="alert alert-danger">
            Hãy đảm bảo thông tin bạn cung cấp là chính xác. Người bán chịu trách nhiệm trước pháp luật.
        </div>

        <form asp-action="RegisterSeller" method="post">
            <div class="mb-3">
                <label class="form-label"><strong>* Tên quán</strong></label>
                <input type="text" class="form-control" name="dinerName" required>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>* Địa chỉ</strong></label>
                <input type="text" class="form-control" name="dinerAddress" required>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>* Mã số thuế</strong></label>
                <input type="text" class="form-control" name="taxCode" required>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>* Email</strong></label>
                <input type="email" class="form-control" value="@ViewBag.Email" readonly>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>* Số điện thoại</strong></label>
                <input type="text" class="form-control" value="@ViewBag.PhoneNumber" readonly>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-danger">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var toastElement = document.getElementById("liveToast");
        if (toastElement) {
            var toast = new bootstrap.Toast(toastElement);
            toast.show();
        }
    });
</script>
