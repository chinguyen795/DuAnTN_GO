@model DuAnTN.Models.UserInfo

@{
    ViewData["Title"] = "Chỉnh Sửa Thông Tin Người Dùng";
}
<!-- Hiển thị thông báo từ TempData -->
@if (TempData["ToastMessage"] != null)
{
    <div class="alert alert-@TempData["ToastType"]" role="alert">
        @TempData["ToastMessage"]
    </div>
}
<div class="container mt-4">
    <h2>✏ Chỉnh Sửa Thông Tin Người Dùng</h2>

    <form asp-controller="Account" asp-action="EditUserInfo" method="post">
        <input type="hidden" asp-for="Id" />

       @*  <div class="form-group">
            <label for="FullName">Họ và tên</label>
            <input type="text" class="form-control" asp-for="FullName" required />
        </div>

        <div class="form-group">
            <label for="Gender">Giới tính</label>
            <select class="form-control" asp-for="Gender">
                <option value="Nam" selected="@Model.Gender == " Nam"">Nam</option>
                <option value="Nữ" selected="@Model.Gender == " Nữ"">Nữ</option>
            </select>
        </div>

        <div class="form-group">
            <label for="Phone">Số điện thoại</label>
            <input type="text" class="form-control" asp-for="Phone" required />
        </div> *@

        <div class="form-group">
            <label for="BirthDay">Ngày sinh</label>
            <input type="date" class="form-control" asp-for="BirthDay" />
        </div>

        <div class="form-group">
            <label for="IdentityCard">Số CCCD</label>
            <input type="text" class="form-control" asp-for="IdentityCard" required />
        </div>

        <button type="submit" class="btn btn-success">Lưu Thay Đổi</button>
        <a asp-controller="Account" asp-action="UserInfo" class="btn btn-secondary">Hủy</a>
    </form>
</div>
