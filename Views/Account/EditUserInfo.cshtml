@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<div class="container d-flex flex-column justify-content-center align-items-center vh-100">
    <h2 class="text-center mb-4">Chỉnh sửa thông tin</h2>

    <div class="alert alert-warning text-center" role="alert" style="max-width: 600px;">
        <h4 class="alert-heading">Chức năng đang phát triển!</h4>
        <p>Chúng tôi xin lỗi vì sự bất tiện này. Trang chỉnh sửa hồ sơ người dùng hiện đang được phát triển. Xin vui lòng quay lại sau để tiếp tục chỉnh sửa thông tin của bạn.</p>
        <hr>
        <p class="mb-0">Cảm ơn bạn đã kiên nhẫn!</p>
    </div>

    <div class="d-flex justify-content-center mt-4" style="margin-top: 30px;">
        <a href="javascript:history.back()" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
<style>
    .container {
        margin-bottom: 40px; /* Thêm khoảng trống dưới bảng hồ sơ */
    }
</style>
