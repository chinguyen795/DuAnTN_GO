@using Newtonsoft.Json
@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"].ToString() == "AddAddress" ? "Thêm Địa Chỉ Giao Hàng" : "Chỉnh Sửa Địa Chỉ";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header text-white text-center" style="background-color: #dc143c;">
                    <h3>@(ViewContext.RouteData.Values["action"].ToString() == "AddAddress" ? "📍 Thêm Địa Chỉ Giao Hàng" : "✏️ Chỉnh Sửa Địa Chỉ")</h3>
                </div>

                <div class="card-body">
                    <!-- Hiển thị thông báo từ TempData -->
                    @if (TempData["ToastMessage"] != null)
                    {
                        <div id="toastMessage" class="alert alert-@TempData["ToastType"] alert-dismissible fade show text-center" role="alert">
                            <i class="bi bi-info-circle"></i> @TempData["ToastMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label text-primary">Số nhà/Tên Đường</label>
                            <input type="text" class="form-control border-red" id="NameAddress" name="NameAddress" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-primary">Tỉnh/Thành phố</label>
                            <select class="form-select border-red" id="Province" name="Province" required>
                                <option value="">Chọn Tỉnh/Thành phố</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-primary">Huyện/Quận</label>
                            <select class="form-select border-red" id="District" name="District" required>
                                <option value="">Chọn Huyện/Quận</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-primary">Xã/Phường</label>
                            <select class="form-select border-red" id="Ward" name="Ward" required>
                                <option value="">Chọn Xã/Phường</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-primary">Địa Chỉ (Không bao gồm số nhà/tên đường)</label>
                            <input type="text" class="form-control border-red" id="Description" name="Description" readonly />
                        </div>

                        <div class="text-center mt-3">
                            <button type="submit" class="btn text-white px-4" style="background-color: #dc143c;">
                                <i class="bi bi-save"></i> @(ViewContext.RouteData.Values["action"].ToString() == "AddAddress" ? "Lưu Địa Chỉ" : "Cập Nhật")
                            </button>
                            <a class="btn btn-secondary px-4" asp-action="Address">
                                <i class="bi bi-arrow-left"></i> Quay Lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CSS: Viền đỏ mỏng cho dropdown -->
<style>
    .border-red {
        border: 1.5px solid #dc143c !important; /* Viền đỏ mỏng */
        background-color: white !important;
        color: black !important;
    }

    .container {
        margin-bottom: 30px; /* Thêm khoảng trống dưới bảng hồ sơ */
    }
</style>

<!-- Script xử lý dropdown tỉnh/thành -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('/data/provinces.json')
            .then(response => {
                if (!response.ok) {
                    throw new Error("Không thể tải dữ liệu provinces.json");
                }
                return response.json();
            })
            .then(data => {
                let provinceSelect = document.getElementById("Province");
                data.forEach(province => {
                    let option = document.createElement("option");
                    option.value = province.name;
                    option.textContent = province.name;
                    provinceSelect.appendChild(option);
                });

                // Lắng nghe sự kiện thay đổi tỉnh/thành phố
                provinceSelect.addEventListener("change", function () {
                    let selectedProvince = this.value;
                    let provinceData = data.find(p => p.name === selectedProvince);
                    updateDistricts(provinceData);
                });

                function updateDistricts(provinceData) {
                    let districtSelect = document.getElementById("District");
                    districtSelect.innerHTML = '<option value="">Chọn Huyện/Quận</option>';

                    if (provinceData && provinceData.districts) {
                        provinceData.districts.forEach(district => {
                            let option = document.createElement("option");
                            option.value = district.name;
                            option.textContent = district.name;
                            districtSelect.appendChild(option);
                        });
                    }

                    // Lắng nghe sự kiện thay đổi quận/huyện
                    districtSelect.addEventListener("change", function () {
                        let selectedDistrict = this.value;
                        let districtData = provinceData.districts.find(d => d.name === selectedDistrict);
                        updateWards(districtData);
                    });
                }

                function updateWards(districtData) {
                    let wardSelect = document.getElementById("Ward");
                    wardSelect.innerHTML = '<option value="">Chọn Xã/Phường</option>';

                    if (districtData && districtData.wards) {
                        districtData.wards.forEach(ward => {
                            let option = document.createElement("option");
                            option.value = ward.name;
                            option.textContent = ward.name;
                            wardSelect.appendChild(option);
                        });
                    }
                }
            })
            .catch(error => {
                console.error("Lỗi khi tải dữ liệu:", error);
                alert("❌ Không thể tải dữ liệu tỉnh/thành. Vui lòng thử lại sau!");
            });

        // Tự động cập nhật trường địa chỉ khi người dùng chọn
        function updateAddress() {
            let province = document.getElementById("Province").value;
            let district = document.getElementById("District").value;
            let ward = document.getElementById("Ward").value;

            let fullAddress = "";
            if (ward) fullAddress += ward + ", ";
            if (district) fullAddress += district + ", ";
            if (province) fullAddress += province;

            document.getElementById("Description").value = fullAddress;
        }

        document.getElementById("Province").addEventListener("change", updateAddress);
        document.getElementById("District").addEventListener("change", updateAddress);
        document.getElementById("Ward").addEventListener("change", updateAddress);
    });

    // Tự động ẩn thông báo sau 4 giây
    setTimeout(function () {
        var toast = document.getElementById('toastMessage');
        if (toast) {
            toast.classList.remove("show");
        }
    }, 4000);
</script>
