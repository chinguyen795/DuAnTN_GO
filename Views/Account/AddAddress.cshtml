@using Newtonsoft.Json
@{
    ViewData["Title"] = "Thêm Địa Chỉ Giao Hàng";
}
<!-- Hiển thị thông báo từ TempData -->
@if (TempData["ToastMessage"] != null)
{
    <div class="alert alert-@TempData["ToastType"]" role="alert">
        @TempData["ToastMessage"]
    </div>
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container">
    <h2>Thêm Địa Chỉ Giao Hàng</h2>
    <form method="post">
        <!-- Tên địa chỉ -->
        <div class="form-group">
            <label for="NameAddress">Số nhà/Tên Đường</label>
            <input type="text" class="form-control" id="NameAddress" name="NameAddress" required />
        </div>

        <!-- Tỉnh/Thành phố -->
        <div class="form-group">
            <label for="Province">Tỉnh/Thành phố</label>
            <select class="form-control" id="Province" name="Province" required>
                <option value="">Chọn Tỉnh/Thành phố</option>
                @foreach (var province in ViewBag.Provinces)
                {
                    <option value="@province.name">@province.name</option>
                }
            </select>
        </div>

        <!-- Quận/Huyện -->
        <div class="form-group">
            <label for="District">Huyện/Quận</label>
            <select class="form-control" id="District" name="District" required>
                <option value="">Chọn Huyện/Quận</option>
            </select>
        </div>

        <!-- Xã/Phường -->
        <div class="form-group">
            <label for="Ward">Xã/Phường</label>
            <select class="form-control" id="Ward" name="Ward" required>
                <option value="">Chọn Xã/Phường</option>
            </select>
        </div>

        <!-- Địa chỉ (Read-Only) -->
        <div class="form-group">
            <label for="Description">Địa Chỉ</label>
            <input type="text" class="form-control" id="Description" name="Description" readonly />
        </div>

        <button type="submit" class="btn btn-primary">Lưu Địa Chỉ</button>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        // Pass the ViewBag data to a JavaScript variable
        var provinces = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Provinces));

        function updateAddressField() {
            var provinceName = $('#Province').val();
            var districtName = $('#District').val();
            var wardName = $('#Ward').val();

            var address = "";

            if (provinceName) {
                address += provinceName;
            }
            if (districtName) {
                address += ", " + districtName;
            }
            if (wardName) {
                address += ", " + wardName;
            }

            $('#Description').val(address);  // Set the "Description" field with the concatenated address
        }

        // Update address field on change
        $('#Province, #District, #Ward').change(function () {
            updateAddressField();
        });

        // Initial update in case the user selects something beforehand
        updateAddressField();

        $('#Province').change(function () {
            var provinceName = $(this).val(); // Get selected province
            if (provinceName) {
                // Find the selected province data
                var province = provinces.find(p => p.name === provinceName);

                var districts = province.districts;
                $('#District').empty().append('<option value="">Chọn Huyện/Quận</option>');

                $.each(districts, function (index, district) {
                    $('#District').append('<option value="' + district.name + '">' + district.name + '</option>');
                });

                $('#Ward').empty().append('<option value="">Chọn Xã/Phường</option>');
            } else {
                $('#District').empty().append('<option value="">Chọn Huyện/Quận</option>');
                $('#Ward').empty().append('<option value="">Chọn Xã/Phường</option>');
            }
        });

        $('#District').change(function () {
            var districtName = $(this).val();
            if (districtName) {
                var provinceName = $('#Province').val();
                var province = provinces.find(p => p.name === provinceName);
                var district = province.districts.find(d => d.name === districtName);
                var wards = district.wards;

                $('#Ward').empty().append('<option value="">Chọn Xã/Phường</option>');

                $.each(wards, function (index, ward) {
                    $('#Ward').append('<option value="' + ward.name + '">' + ward.name + '</option>');
                });
            } else {
                $('#Ward').empty().append('<option value="">Chọn Xã/Phường</option>');
            }
        });
    });
</script>
