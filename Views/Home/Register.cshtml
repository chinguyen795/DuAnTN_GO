@model DuAnTN.Models.User
@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="container my-5 d-flex justify-content-center">
    <div class="card p-4 shadow-lg" style="max-width: 500px; width: 100%;">
        <h2 class="text-center">Nhập thông tin tài khoản</h2>

        <form method="post" asp-controller="Home" asp-action="Register">
            <div class="mb-3">
                <label>Email</label>
                <input class="form-control" type="text" name="Email" value="@ViewBag.Email" readonly />
            </div>

            <div class="mb-3">
                <label>Họ & Tên</label>
                <input type="text" class="form-control" name="FullName" placeholder="Họ & Tên" required />
                <span class="text-danger" asp-validation-for="FullName"></span>
            </div>

            <div class="mb-3">
                <label>Số điện thoại</label>
                <input type="text" class="form-control" name="Phone" placeholder="Số điện thoại" />
                <span class="text-danger" asp-validation-for="Phone"></span>
            </div>

            <div class="mb-3">
                <label>Mật khẩu</label>
                <input type="password" class="form-control" name="Password" placeholder="Mật khẩu" required />
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>

            <div class="mb-3">
                <label>Nhập lại mật khẩu</label>
                <input type="password" class="form-control" name="RePassword" placeholder="Nhập lại mật khẩu" required />
                <span class="text-danger" asp-validation-for="RePassword"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng Kí</button>
        </form>
    </div>
</div>