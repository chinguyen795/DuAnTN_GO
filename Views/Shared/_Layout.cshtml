<!doctype html>
<html lang="en">

<head>
    <title>Trang Chủ</title>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- Bootstrap CSS v5.2.1 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />
	<link href="~/css/stylesheet.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <div class="nav row">
            <div class="col-1"></div>
            <div class="col-2 nav-logo">
                <a asp-controller="Home" asp-action="index">
                    <img src="~/image/img-go.png" alt="" height="90" />
                </a>
            </div>

            <div class="col-6 search">
                <div class="input-group">
                    <input class="search-input form-control rounded-pill" type="text" placeholder="Search">
                </div>
            </div>

            <div class="actions col-2 d-flex align-items-center">
                <a asp-area="" asp-controller="Cart" asp-action="index">
                    <div class="actions-buy d-flex align-items-center text-center ms-auto">
                        <div class="actions-cart position-relative text-center">
                            <i class="bi bi-basket2 fs-3 text-white"></i>
                            <span class="quantity position-absolute badge rounded-pill">3</span>
                        </div>

                        <div class="actions-like position-relative text-center">
                            <i class="bi bi-heart fs-3 text-white"></i>
                            <span class="quantity position-absolute badge rounded-pill">5</span>
                        </div>
                    </div>
                </a>


                <div class="actions-account d-flex align-items-center text-center">
                    @if (Context.Session.GetString("Id") != null)
                    {
                        <select class="form-select text-white" id="accountOptions" onchange="handleAccountOption(this.value)">
                            <option selected disabled>@Context.Session.GetString("FullName")</option>
                            <option value="profile">🔹 Hồ sơ cá nhân</option>
                            <option value="logout">🚪 Đăng xuất</option>
                        </select>
                    }
                    else
                    {
                        <div class="actions-account-signin" data-bs-toggle="modal" data-bs-target="#signin">
                            <a href="#">Sign In</a>
                        </div>
                        <div class="line text-white">|</div>
                        <div class="actions-account-login" data-bs-toggle="modal" data-bs-target="#login">
                            <a href="#">Log In</a>
                        </div>
                    }
                </div>

            </div>
            <div class="col-1"></div>

        </div>
    </header>
        <main role="main">
            @RenderBody()

        </main>
    <footer>
        <div class="footer-header container">
            <div class="content-basic row">
                <div class="col-4 customer care d-flex align-items-center">
                    <i class="bi bi-chat-fill fs-4 me-2"></i>
                    <div class="content-main">
                        <p class="m-0">Chăm sóc khách hàng</p>
                        <p class="m-0"> Chat is unavailable</p>
                    </div>
                </div>
                <div class="col-4 download d-flex align-items-center">
                    <i class="bi bi-arrow-down-circle fs-4 me-2"></i>
                    <div class="content-main">
                        <p class="m-0">Tải ngay</p>
                        <p class="m-0">Download Now</p>
                    </div>
                </div>
                <div class="col-4 notification d-flex align-items-center">
                    <i class="bi bi-phone fs-4 me-2"></i>
                    <div class="content-main">
                        <p class="m-0">Nhận thông báo ngay</p>
                        <p class="m-0">Đăng nhập ngay</p>
                    </div>
                </div>
            </div>
        </div>
        <hr class="line-1">
        <div class="footer-main container">
            <div class="content-main row">
                <div class="col-3 about us d-bock">
                    <p class="fs-5">Về chúng tôi</p>
                    <p>Giới thiệu</p>
                    <p>Quy chế</p>
                    <p>Bảo mật thông tin</p>
                    <p>Giấy phép</p>
                </div>
                <div class="col-3 service">
                    <p class="fs-5">Dịch vụ khách hàng</p>
                    <p>Trợ giúp</p>
                    <p>Giải quyết khiếu nại</p>
                    <p>liên hệ</p>
                    <p>CSKHCSKH</p>
                </div>
                <div class="col-3 job">
                    <p class="fs-5">Công việc</p>
                    <p>Hợp tác bán hàng</p>
                    <p>Hợp tác vận chuyển</p>
                    <p>Liên hệ việc làm</p>
                    <p>Quảng cáo</p>
                </div>
                <div class="col-3 infor">
                    <a href="">
                        <img src="~/image/IMG-GO.png" alt="" height="150">
                    </a>
                    <br>
                    <i class="infor-icon fs-4 bi bi-instagram"></i>
                    <i class="infor-icon fs-4 bi bi-twitter-x"></i>
                    <i class="infor-icon fs-4 bi bi-youtube"></i>
                    <i class="infor-icon fs-4 bi bi-tiktok"></i>
                    <i class="infor-icon fs-4 bi bi-facebook"></i>
                </div>
            </div>
            <hr class="line-1">

            <div class="footer-end container">
                <p class="">Toà nhà FPT Polytechnic, đường số 22, phường Thường Thạnh, quận Cái Răng, TP Cần Thơ</p>
                <div class="footer-end-tt d-flex">
                    <p class="me-5">Sitemap</p>
                    <p class="me-5">Terms of Use</p>
                    <p class="me-5">Accessibility</p>
                    <p class="me-5">Sitemap</p>
                </div>
                <p>GO: https://github.com/chinguyen795/DuAnTN.git</p>
            </div>


    </footer>
    <script src="https://cdn.jsdelivr.net/npm/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
            integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
			crossorigin="anonymous"></script>
	<script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function handleAccountOption(value) {
            if (value === "profile") {
                window.location.href = "/Account/UserInfo"; // Điều hướng đến trang Hồ sơ cá nhân
            } else if (value === "logout") {
                window.location.href = "/Home/Logout"; // Điều hướng đến trang Đăng xuất
            }
        }
    </script>
</body>
</html>
