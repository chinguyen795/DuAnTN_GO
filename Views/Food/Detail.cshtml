@model DuAnTN.Models.Food

<div class="container mt-4">
    <div class="row">
        <!-- Ảnh sản phẩm -->
        <div class="col-md-6">
            <div class="product-details__image-container">
                <img id="mainImage" src="@Model.MainImage" alt="FoodName">
            </div>
            <div class="product-details__thumbnail mt-2">
                <img src="@Model.MainImage" alt="Thumbnail 1" class="thumb" onclick="changeMainImage(this)">
                <img src="@Model.Image1" alt="Thumbnail 2" class="thumb" onclick="changeMainImage(this)">
                <img src="@Model.Image2" alt="Thumbnail 3" class="thumb" onclick="changeMainImage(this)">
            </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6 product-details">
            <span class="badge bg-danger">❤️ Yêu thích</span>
            <h2 class="product-details__title mt-2">@Model.FoodName</h2>
            <p class="product-details__info">@Model.Diner?.DinerName | @Model.Diner?.DinerAddress</p>

            <div class="product-details__rating">
                <span>⭐ 4.7</span>
                <span class="text-success">• 586 đánh giá</span>
                <span class="text-success">• Mở cửa</span>
            </div>

            <p class="mt-3">Số Lượng</p>
            <div class="cart-quantity-control align-items-start has-out-of-stock">
                <div class="cart-quantity-buttons">
                    <button type="button" class="btn btn-light" onclick="updateQuantity(-1)">-</button>
                    <input type="number" id="quantity" value="1" min="1" readonly>
                    <button type="button" class="btn btn-light" onclick="updateQuantity(1)">+</button>
                </div>
            </div>

            <p class="mt-3">Tạm tính: <span id="totalPrice" class="product-details__price">@Model.Price.ToString("N0")đ</span></p>
            <a href="Pay.html" class="btn btn-buy mt-3">Mua ngay</a>
            <form method="post" asp-controller="Cart" asp-action="AddToCart">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" id="quantityInput" name="quantity" value="1" />

                <button type="submit" class="btn btn-cart mt-2">Thêm vào giỏ</button>
            </form>


        </div>
    </div>

    <div class="row mt-3">
        <div class="col-6">
            <p class="fw-bold fs-4">Ưu đãi khác</p>
            <button class="btn btn-danger mt-2">Chưa có</button>
        </div>
        <div class="col-6">
            <div class="product-details__shipping">
                <img src="icon-shipping.png" alt="Shipping Icon">
                <p>Hãy nhập địa chỉ nhận hàng</p>
            </div>
            <button class="btn btn-primary mt-2">Nhập địa chỉ</button>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function updateQuantity(change) {
        let quantityInput = $("#quantity");
        let quantityHiddenInput = $("#quantityInput"); // Input ẩn để lưu số lượng gửi đi
        let totalPriceLabel = $("#totalPrice");
        let foodId = @Model.Id;
        let currentQuantity = parseInt(quantityInput.val()) + change;

        if (currentQuantity < 1) currentQuantity = 1;

        $.ajax({
            url: "/Food/UpdateQuantity",
            type: "GET",
            data: { foodId: foodId, quantity: currentQuantity },
            success: function (response) {
                quantityInput.val(response.quantity);
                quantityHiddenInput.val(response.quantity); // Cập nhật input ẩn
                totalPriceLabel.text(response.totalPrice.toLocaleString() + "đ");
            },
            error: function () {
                alert("Có lỗi xảy ra khi cập nhật số lượng!");
            }
        });
    }
</script>
