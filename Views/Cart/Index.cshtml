@using DuAnTN.Extensions
@model List<DuAnTN.Models.Food>
@inject IHttpContextAccessor HttpContextAccessor

@{
    var cartItems = HttpContextAccessor.HttpContext.Session.Get<Dictionary<int, int>>("CartQuantity") ?? new Dictionary<int, int>();
    var totalProducts = cartItems.Any() ? cartItems.Sum(x => x.Value) : 0; // Tổng số lượng sản phẩm
    var totalPrice = Model != null && Model.Any()
        ? Model.Sum(item => (decimal)item.Price * (cartItems.ContainsKey(item.Id) ? cartItems[item.Id] : 1))
        : 0; // Tính tổng tiền
}

<div class="container cart mt-4">
    <div class="cart-header d-flex justify-content-between align-items-center py-2">
        <span class="cart-header-title">Tất cả sản phẩm đã thêm: <strong>@totalProducts</strong> sản phẩm</span>
    </div>
    <div class="cart-table-container mt-3">
        <table class="table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var quantity = cartItems.ContainsKey(item.Id) ? cartItems[item.Id] : 1;
                        <tr>
                            <td>
                                <img src="@item.MainImage" alt="@item.FoodName" height="80px"> @item.FoodName
                            </td>
                            <td>@item.Price.ToString("N0")đ</td>
                            <td>@quantity</td>
                            <td>@(item.Price * quantity).ToString("N0")đ</td>
                            <td>
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.Id })" class="btn btn-danger btn-sm">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Giỏ hàng trống!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="cart-summary-container">
            <p><strong>Tổng sản phẩm:</strong> <span class="text-dark">@totalProducts</span> sản phẩm</p>
            <p>
                <strong>Tổng thanh toán:</strong> <span class="text-danger">
                    @totalPrice.ToString("N0")đ
                </span>
            </p>
            <a href="@Url.Action("Pay", "Cart")" class="btn btn-success">Thanh toán</a>
        </div>
    }
</div>
